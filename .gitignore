.ipynb_checkpoints/

# files
log/
data/
*.csv

# scratch scripts/notebooks in the repo root (throwaway experiments, never
# committed). Narrow, root-anchored patterns -- NOT a bare `test*`, which also
# swallowed the tracked `tests/` suite.
/test-*.py
/test-*.ipynb
/test.py

# run-record SQLite db, its derived files and snapshots (the default paths live under data/
# which is already ignored; this also covers files pointed elsewhere)
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3.gz
*.sqlite3.gz.sha256

# config
conf/conf.ini
service/endpoints.json
*.zip
